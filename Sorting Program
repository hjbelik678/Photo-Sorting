        # Log Output Textbox
        self.log_textbox = ctk.CTkTextbox(self, height=180)
        self.log_textbox.pack(fill="both", expand=True, padx=20, pady=(0, 15))

    def make_path_row(self, parent, label_text, variable):
        frame = ctk.CTkFrame(parent, fg_color="transparent")
        frame.pack(fill="x", padx=15, pady=5)
        ctk.CTkLabel(frame, text=label_text, width=140, anchor="w").pack(
            side="left"
        )
        entry = ctk.CTkEntry(frame, textvariable=variable)
        entry.pack(side="left", expand=True, fill="x", padx=(0, 10))
        btn = ctk.CTkButton(
            frame, text="Browse", width=80, command=lambda: self.browse(variable)
        )
        btn.pack(side="right")
        return entry, btn

    def browse(self, variable):
        path = filedialog.askdirectory()
        if path:
            variable.set(path)

    def toggle_video_entry(self):
        state = "normal" if self.sep_video_switch.get() else "disabled"
        self.video_entry.configure(state=state)
        self.video_btn.configure(state=state)

    def toggle_cleanup_switch(self):
        is_move_mode = self.action_var.get() == "move"
        if is_move_mode:
            self.cleanup_cb.configure(state="normal")
        else:
            self.cleanup_cb.configure(state="disabled")

    def open_settings(self):
        if (
            self.settings_window is None
            or not self.settings_window.winfo_exists()
        ):
            self.settings_window = FileTypeSettingsWindow(self, self.ext_vars)
        else:
            self.settings_window.focus()

    def start_sort(self):
        cancel_flag.clear()
        self.log_textbox.delete("1.0", "end")
        self.progress_bar.set(0)

        source = self.source_var.get()
        dest = self.dest_var.get()
        log_dir = self.log_var.get()
        video_dest = self.video_dest_var.get()
        use_sep_video = bool(self.sep_video_switch.get())
        dry_run = self.dry_run_var.get()
        cleanup_source = self.cleanup_source_var.get()

        selected_exts = [
            ext for ext, var in self.ext_vars.items() if var.get()
        ]
        if not selected_exts:
            messagebox.showerror(
                "Missing Input",
                "Select at least one file extension in Settings.",
            )
            return

        if not source or not dest:
            messagebox.showerror(
                "Missing Input",
                "Please select both Source and Destination folders.",
            )
            return

        if use_sep_video and not video_dest:
            messagebox.showerror(
                "Missing Input", "Please select a Video Destination Folder."
            )
            return

        try:
            start_date = datetime.strptime(
                self.start_date_var.get(), "%Y-%m-%d"
            )
            end_date = datetime.strptime(self.end_date_var.get(), "%Y-%m-%d")
        except ValueError:
            messagebox.showerror(
                "Invalid Date", "Dates must be formatted as YYYY-MM-DD."
            )
            return

        log_path = Path(log_dir)

        # 1. Verify drive existence (Windows specific)
        if log_path.drive and not Path(log_path.drive + "\\").exists():
            messagebox.showerror(
                "Drive Error",
                f"The specified drive '{log_path.drive}' was not found. Please connect the drive or select a different location.",
            )
            return

        # 2. Try creating the log directory safely
        try:
            log_path.mkdir(parents=True, exist_ok=True)
        except Exception as e:
            messagebox.showerror("Path Error", f"Could not create folder:\n{e}")
            return

        copy_mode = self.action_var.get() == "copy"

        self.start_btn.configure(state="disabled")

        threading.Thread(
            target=sort_files_gui,
            args=(
                source,
                dest,
                log_dir,
                video_dest,
                use_sep_video,
                lambda msg: self.log_textbox.insert("end", msg + "\n"),
                selected_exts,
                start_date,
                end_date,
                copy_mode,
                dry_run,
                cleanup_source,
                lambda pct: self.progress_bar.set(pct),
                self.on_sort_complete,
            ),
            daemon=True,
        ).start()

    def on_sort_complete(self, summary_data):
        self.start_btn.configure(state="normal")
        SummaryWindow(self, summary_data)

    def cancel_sort(self):
        cancel_flag.set()


if __name__ == "__main__":
    app = ModernPhotoSorter()
    app.mainloop()
