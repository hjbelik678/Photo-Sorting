def sort_files_gui(
    source_folder,
    destination_base,
    log_folder,
    video_destination_base,
    use_separate_video_dir,
    log_callback,
    allowed_extensions,
    date_start,
    date_end,
    copy_mode,
    dry_run,
    cleanup_source,
    progress_callback,
    finish_callback,
):
    source_folder = Path(source_folder)
    destination_base = Path(destination_base)
    video_destination_base = (
        Path(video_destination_base)
        if use_separate_video_dir
        else destination_base
    )
    log_folder = Path(log_folder)
    folder_cache = {}

    folder_lock = threading.Lock()
    hash_lock = threading.Lock()
    existing_hashes = {}  # Map: MD5 -> Dest Path

    start_time = datetime.now()
    prefix = "[DRY RUN] " if dry_run else ""
    log_file_path = (
        log_folder
        / f"sort_log_{start_time.strftime('%Y-%m-%d_%H-%M-%S')}.txt"
    )

    summary_data = {
        "processed": 0,
        "renamed": 0,
        "duplicates": 0,
        "out_of_range": 0,
        "errors": [],
        "skip_details": [],
    }

    def log(message):
        log_callback(f"{prefix}{message}")
        with open(log_file_path, "a", encoding="utf-8") as log_file:
            log_file.write(
                f"{datetime.now().strftime('%Y-%m-%d %H:%M:%S')} - {prefix}{message}\n"
            )

    log("Scanning directory...")
    all_files = fast_scandir(source_folder, allowed_extensions)
    total = len(all_files)
    log(f"Found {total} target media files.")

    def process_file(file_path):
        if cancel_flag.is_set():
            return None

        date_taken = get_date_taken(file_path)
        if not date_taken:
            msg = f"Skipped: No date metadata found for {file_path.name}"
            return {"type": "skip", "msg": msg, "reason": "no_date"}

        if not (date_start <= date_taken <= date_end):
            msg = f"Skipped: {file_path.name} (Date {date_taken.strftime('%Y-%m-%d')} out of range)"
            return {"type": "skip", "msg": msg, "reason": "out_of_range"}

        is_video = file_path.suffix.lower() in video_extensions
        target_base = (
            video_destination_base
            if (is_video and use_separate_video_dir)
            else destination_base
        )

        year = str(date_taken.year)
        month_name = (
            f"{date_taken.month} {date_taken.strftime('%B')} {date_taken.year}"
        )
        day_name_base = (
            f"{date_taken.month}-{date_taken.day}-{date_taken.year}"
        )
        cache_key = (str(target_base), year, month_name, day_name_base)

        with folder_lock:
            dest_folder = folder_cache.get(cache_key)
            if not dest_folder:
                parent_folder = target_base / year / month_name
                if parent_folder.exists():
                    for child in parent_folder.iterdir():
                        if child.is_dir() and child.name.startswith(
                            day_name_base
                        ):
                            dest_folder = child
                            break

                if not dest_folder:
                    dest_folder = parent_folder / day_name_base
                    if not dry_run:
                        dest_folder.mkdir(parents=True, exist_ok=True)

                folder_cache[cache_key] = dest_folder

        # 1. Check duplicate content via Hash FIRST
        file_hash = calculate_file_hash(file_path)
        if file_hash:
            with hash_lock:
                if file_hash in existing_hashes:
                    dup_target = existing_hashes[file_hash]
                    msg = f"Skipped Duplicate: {file_path.name} (Matches {dup_target.name})"
                    return {"type": "skip", "msg": msg, "reason": "duplicate"}

        # 2. Collision Handling: Handle different files with matching filenames
        with folder_lock:
            dest_path = get_unique_dest_path(dest_folder, file_path.name)
            if file_hash:
                with hash_lock:
                    existing_hashes[file_hash] = dest_path

        was_renamed = dest_path.name != file_path.name

        # 3. Execute Copy / Move
        if dry_run:
            action_str = "Would Copy" if copy_mode else "Would Move"
            rename_note = (
                f" (Renamed to {dest_path.name})" if was_renamed else ""
            )
            msg = f"{action_str} {file_path.name} -> {dest_folder}{rename_note}"
            return {"type": "success", "msg": msg, "renamed": was_renamed}

        try:
            if copy_mode:
                shutil.copy2(file_path, dest_path)
                rename_note = (
                    f" (Renamed to {dest_path.name})" if was_renamed else ""
                )
                msg = f"Copied {file_path.name} to {dest_path}{rename_note}"
            else:
                try:
                    shutil.move(str(file_path), str(dest_path))
                    rename_note = (
                        f" (Renamed to {dest_path.name})" if was_renamed else ""
                    )
                    msg = f"Moved {file_path.name} to {dest_path}{rename_note}"
                except OSError:
                    shutil.copy2(file_path, dest_path)
                    file_path.chmod(stat.S_IWRITE)
                    file_path.unlink()
                    rename_note = (
                        f" (Renamed to {dest_path.name})" if was_renamed else ""
                    )
                    msg = f"Copied and deleted: {file_path.name}{rename_note}"
            return {"type": "success", "msg": msg, "renamed": was_renamed}
        except Exception as err:
            msg = f"Error processing {file_path.name}: {err}"
            return {"type": "error", "msg": msg}

    completed = 0
    max_workers = min(32, (os.cpu_count() or 1) + 4)
    with ThreadPoolExecutor(max_workers=max_workers) as executor:
        futures = {executor.submit(process_file, f): f for f in all_files}

        for future in as_completed(futures):
            if cancel_flag.is_set():
                log("Sorting cancelled by user.")
                break

            result = future.result()
            completed += 1
            if progress_callback and total:
                progress_callback(completed / total)

            if not result:
                continue

            if result["type"] == "success":
                summary_data["processed"] += 1
                if result.get("renamed"):
                    summary_data["renamed"] += 1
                log(result["msg"])
            elif result["type"] == "skip":
                summary_data["skip_details"].append(result["msg"])
                log(result["msg"])
                if result.get("reason") == "duplicate":
                    summary_data["duplicates"] += 1
                elif result.get("reason") == "out_of_range":
                    summary_data["out_of_range"] += 1
            elif result["type"] == "error":
                summary_data["errors"].append(result["msg"])
                summary_data["skip_details"].append(result["msg"])
                log(result["msg"])

    # Optional Post-Sort Empty Folder Cleanup (Move mode only)
    if cleanup_source and not copy_mode and not cancel_flag.is_set():
        log("Cleaning up empty source subfolders...")
        cleaned_count = cleanup_empty_folders(
            source_folder, log, dry_run=dry_run
        )
        log(f"Cleaned up {cleaned_count} empty folder(s).")

    log("Operation finished.")
    finish_callback(summary_data)


