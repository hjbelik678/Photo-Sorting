            config_frame, text="Start Date:", font=ctk.CTkFont(weight="bold")
        ).grid(row=1, column=0, padx=15, pady=10, sticky="w")
        ctk.CTkEntry(
            config_frame, textvariable=self.start_date_var, width=110
        ).grid(row=1, column=1, sticky="w")
        ctk.CTkLabel(
            config_frame, text="End Date:", font=ctk.CTkFont(weight="bold")
