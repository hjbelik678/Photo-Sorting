def global_exception_handler(exc_type, exc_value, exc_traceback):
    """Log uncaught errors to file and show a popup message box."""
    if issubclass(exc_type, KeyboardInterrupt):
        sys.__excepthook__(exc_type, exc_value, exc_traceback)
        return

    logging.error(
        "Uncaught exception encountered",
        exc_info=(exc_type, exc_value, exc_traceback),
    )

    messagebox.showerror(
        "Unexpected Application Error",
        f"An error occurred while running the app:\n\n{exc_value}\n\nError details saved to:\n{LOG_FILE}",
    )


# Intercept system and Tkinter errors globally
sys.excepthook = global_exception_handler
tk.Tk.report_callback_exception = global_exception_handler


# High-speed recursive directory scanner
def fast_scandir(top_dir, allowed_extensions):
    files = []
    try:
        for entry in os.scandir(top_dir):
            if entry.is_dir(follow_symlinks=False):
                files.extend(fast_scandir(entry.path, allowed_extensions))
            elif entry.is_file(follow_symlinks=False):
                ext = os.path.splitext(entry.name)[1].lower()
                if ext in allowed_extensions:
                    files.append(Path(entry.path))
    except PermissionError:
        pass
    return files


# Cleanup empty subdirectories in source folder after move operation
def cleanup_empty_folders(top_dir, log_func, dry_run=False):
    cleaned = 0
    for root, dirs, files in os.walk(top_dir, topdown=False):
        for name in dirs:
            folder_path = Path(root) / name
            try:
                if not any(folder_path.iterdir()):
                    if not dry_run:
                        folder_path.rmdir()
                    log_func(f"Cleaned up empty folder: {folder_path.name}")
                    cleaned += 1
            except Exception:
                pass
    return cleaned


# Compute MD5 Hash for Duplicate Detection
def calculate_file_hash(path: Path, chunk_size=65536):
    hasher = hashlib.md5()
    try:
        with open(path, "rb") as f:
            while chunk := f.read(chunk_size):
                hasher.update(chunk)
        return hasher.hexdigest()
    except Exception:
        return None


def get_video_date(path: Path):
    try:
        parser = createParser(str(path))
        if parser:
            with parser:
                metadata = extractMetadata(parser)
                if metadata:
                    for item in metadata.exportPlaintext():
                        if "Creation date:" in item:
                            date_str = item.split("Creation date:")[1].strip()
                            return datetime.strptime(
                                date_str, "%Y-%m-%d %H:%M:%S"
                            )
    except Exception:
        pass
    return None


def get_date_taken(path: Path):
    ext = path.suffix.lower()

    if ext in video_extensions:
        v_date = get_video_date(path)
        if v_date:
            return v_date

    if ext in image_extensions:
        try:
            with Image.open(path) as image:
                exif_data = image.getexif()
                for tag in ["DateTimeOriginal", "DateTimeDigitized", "DateTime"]:
                    tag_id = next(
                        (k for k, v in TAGS.items() if v == tag), None
                    )
                    if tag_id and tag_id in exif_data:
                        value = exif_data.get(tag_id)
                        return datetime.strptime(value, "%Y:%m:%d %H:%M:%S")
        except Exception:
            pass

    try:
        return datetime.fromtimestamp(path.stat().st_mtime)
    except Exception:
        return None


# Generate unique filename for non-duplicate collisions
def get_unique_dest_path(dest_folder: Path, original_filename: str):
    base_path = dest_folder / original_filename
    if not base_path.exists():
        return base_path

    stem = base_path.stem
    suffix = base_path.suffix
    counter = 1

    while True:
        candidate = dest_folder / f"{stem}_{counter}{suffix}"
        if not candidate.exists():
            return candidate
        counter += 1


